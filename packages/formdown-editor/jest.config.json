{
    "projects": [
        {
            "displayName": "unit",
            "testEnvironment": "jsdom",
            "roots": [
                "<rootDir>/src",
                "<rootDir>/__tests__"
            ],
            "testMatch": [
                "**/__tests__/*.test.ts"
            ],
            "collectCoverageFrom": [
                "src/**/*.ts",
                "!src/**/*.d.ts",
                "!src/vite-env.d.ts"
            ],
            "moduleNameMapper": {
                "\\.css\\?inline$": "<rootDir>/__tests__/mocks/empty.js",
                "^lit$": "<rootDir>/__tests__/mocks/lit.js",
                "^lit/decorators.js$": "<rootDir>/__tests__/mocks/lit-decorators.js",
                "^@formdown/ui$": "<rootDir>/__tests__/mocks/empty.js",
                "^@formdown/core$": "<rootDir>/../formdown-core/src/index.ts",
                "^(\\.{1,2}/.*)\\.js$": "$1"
            },
            "transform": {
                "^.+\\.[jt]s$": [
                    "@swc/jest",
                    {
                        "jsc": {
                            "parser": {
                                "syntax": "typescript",
                                "decorators": true
                            },
                            "transform": {
                                "legacyDecorator": true,
                                "decoratorMetadata": false,
                                "useDefineForClassFields": false
                            },
                            "target": "es2020"
                        },
                        "module": {
                            "type": "commonjs"
                        }
                    }
                ]
            },
            "transformIgnorePatterns": [
                "node_modules/(?!marked/)"
            ]
        },
        {
            "displayName": "render",
            "testEnvironment": "jsdom",
            "roots": [
                "<rootDir>/__tests__/render"
            ],
            "testMatch": [
                "**/__tests__/render/**/*.test.ts"
            ],
            "moduleNameMapper": {
                "\\.css\\?inline$": "<rootDir>/__tests__/mocks/empty.js",
                "^@formdown/ui$": "<rootDir>/../formdown-ui/src/index.ts",
                "^@formdown/core$": "<rootDir>/../formdown-core/src/index.ts",
                "^(\\.{1,2}/.*)\\.js$": "$1"
            },
            "transform": {
                "^.+\\.[jt]s$": [
                    "@swc/jest",
                    {
                        "jsc": {
                            "parser": {
                                "syntax": "typescript",
                                "decorators": true
                            },
                            "transform": {
                                "legacyDecorator": true,
                                "decoratorMetadata": false,
                                "useDefineForClassFields": false
                            },
                            "target": "es2020"
                        },
                        "module": {
                            "type": "commonjs"
                        }
                    }
                ]
            },
            "transformIgnorePatterns": [
                "node_modules/(?!(lit|@lit|lit-element|lit-html|@lit/reactive-element|marked)/)"
            ]
        }
    ]
}
