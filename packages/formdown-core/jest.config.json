{
    "testEnvironment": "node",
    "transform": {
        "^.+\\.[jt]s$": [
            "@swc/jest",
            {
                "jsc": {
                    "parser": {
                        "syntax": "typescript",
                        "decorators": false
                    },
                    "transform": {},
                    "target": "es2020"
                },
                "module": {
                    "type": "commonjs"
                }
            }
        ]
    },
    "transformIgnorePatterns": [
        "node_modules/(?!marked/)"
    ],
    "moduleNameMapper": {
        "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "testMatch": [
        "**/__tests__/**/*.test.ts"
    ]
}
